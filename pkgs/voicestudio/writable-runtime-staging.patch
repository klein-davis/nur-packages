+/**
+ * fs.cp keeps source modes, so a bundle on a read-only install (the Nix store,
+ * a read-only mount) would stage a tree the backend cannot write and the next
+ * update cannot remove. Grant the owner write access, never following links.
+ */
+async function makeOwnerWritable(path: string): Promise<void> {
+  const info = await lstat(path).catch(() => null);
+  if (!info || info.isSymbolicLink()) return;
+  if ((info.mode & 0o200) === 0) await chmod(path, info.mode | 0o200);
+  if (info.isDirectory()) {
+    for (const entry of await readdir(path)) await makeOwnerWritable(join(path, entry));
+  }
+}
